# Supabase Project Settings > API. Publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Supabase Connect > Transaction pooler (port 6543). Server-only secret.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres
# Verified email addresses only; never assign this role from user metadata.
TEACHER_ADMIN_EMAILS=
# Enable only after enabling Anonymous Sign-Ins in Supabase Auth.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
