# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nt2_taalcoach?schema=public"

# Auth.js (v5)
AUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-please-run-openssl-rand-hex-32"
AUTH_TRUST_HOST="true"

# NextAuth (backwards compat placeholder)
NEXTAUTH_SECRET="change-me-please-run-openssl-rand-hex-32"

# OpenAI
OPENAI_API_KEY="sk-placeholder"
OPENAI_MODEL="gpt-4o-mini"

# MiraConverse-style local LLM via Ollama's OpenAI-compatible endpoint
MIRA_CONVERSE_API_BASE="http://127.0.0.1:11434/v1"
MIRA_CONVERSE_MODEL="llama3.1:8b"
MIRA_CONVERSE_API_KEY="ollama"
OLLAMA_MODEL="llama3.1:8b"

# Local voice runtime
VOICE_RUNTIME_URL="http://127.0.0.1:8001"
FASTER_WHISPER_MODEL="base"
FASTER_WHISPER_DEVICE="cpu"
FASTER_WHISPER_COMPUTE_TYPE="int8"
PIPER_BIN="piper"
PIPER_MODEL_PATH="/absolute/path/to/nl_NL-alex-medium.onnx"
